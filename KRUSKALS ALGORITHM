
#include <iostream>
#include <algorithm>
using namespace std;

// Edge structure
struct Edge {
    int u, v, w;  // u = start, v = end, w = weight
};

bool cmp(Edge a, Edge b) {
    return a.w < b.w;
}

int parent[100];

int find(int x) {
    if (parent[x] == x)
        return x;
    return parent[x] = find(parent[x]);
}

int main() {
    int vertices = 4;  // Number of vertices
    int edges = 5;     // Number of edges

    Edge e[5] = {
        {0, 1, 1},
        {0, 2, 4},
        {1, 2, 2},
        {1, 3, 5},
        {2, 3, 3}
    };

    sort(e, e + edges, cmp);

    for (int i = 0; i < vertices; i++)
        parent[i] = i;

    int cost = 0, count = 0;

    cout << "Vertices = " << vertices << endl;
    cout << "Edges = " << edges << endl;
    cout << "Minimum Spanning Tree:\n";

    for (int i = 0; i < edges && count < vertices - 1; i++) {
        int a = find(e[i].u);
        int b = find(e[i].v);

        if (a != b) {
            cout << e[i].u << " - "
                 << e[i].v << " : "
                 << e[i].w << endl;

            parent[a] = b;
            cost += e[i].w;
            count++;
        }
    }

    cout << "Minimum cost = " << cost << endl;

    return 0;
}
